{
  "name": "final-slate-build",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SLATE: a text simulation of writing, producing, directing and acting in screen productions.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "balance": "vitest run --config vitest.balance.config.ts",
    "check": "npm run world:check && npm run typecheck && npm run test && npm run build && npm run budget",
    "catalog": "node scripts/trim-genre-registry.mjs",
    "world:check": "node scripts/world-import.mjs",
    "world:legacy": "node scripts/legacy-places.mjs",
    "budget": "node scripts/perf-budget.mjs",
    "perf:engine": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "6.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
