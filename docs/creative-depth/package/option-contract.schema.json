{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SLATE Creative Option \u2014 blueprint contract",
  "type": "object",
  "required": [
    "id",
    "version",
    "field",
    "label",
    "description",
    "provenance",
    "patch",
    "bindings",
    "classification",
    "testIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "field": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "sourceRefs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "original-authored",
            "sourced-fact",
            "simulation"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array"
    },
    "excludes": {
      "type": "array"
    },
    "patch": {
      "type": "object"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "consumer",
          "scope",
          "parameters",
          "implementationStatus"
        ],
        "properties": {
          "consumer": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "project",
              "scene",
              "episode",
              "character",
              "asset",
              "person",
              "contract"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "implementationStatus": {
            "enum": [
              "proposed-not-implemented",
              "implemented",
              "engine-tested",
              "browser-tested"
            ]
          }
        }
      }
    },
    "classification": {
      "enum": [
        "mechanical-proposal",
        "creative-brief",
        "mechanical",
        "reference"
      ]
    },
    "testIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
